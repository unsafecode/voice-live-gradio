# ── Mode selector ─────────────────────────────────────────────────────
# realtime  → Azure OpenAI Realtime API           (rung 1, the "before")
# voicelive → Azure AI Foundry Voice Live         (rung 2, the punchline)
# agent     → Voice Live + Foundry Agent          (rung 3, hosted agent)
# demo      → unified switcher — all rungs in one UI  (default)
MODE=demo

# ── Azure (all modes — same Foundry resource) ─────────────────────────
# Replace <your-foundry-resource> with the Azure AI Foundry resource name
# you provisioned. The two URLs share the same host stem; only the
# subdomain differs (.openai vs .services.ai).
AZURE_OPENAI_ENDPOINT="https://<your-foundry-resource>.openai.azure.com"
AZURE_VOICELIVE_ENDPOINT="wss://<your-foundry-resource>.services.ai.azure.com/voice-live"

# Name of the realtime model you deployed in the Foundry resource above.
# Voice Live also hosts a curated allow-list of managed models (gpt-realtime,
# gpt-realtime-mini, gpt-5-mini, gpt-4o-mini, …) that you do NOT need to
# deploy yourself — those are reachable from the unified switcher / benchmark.
AZURE_OPENAI_DEPLOYMENT_NAME="gpt-realtime-1.5"

# Realtime stays on the still-supported preview line because openai 2.x
# hasn't adopted the GA /openai/v1/realtime URL yet. Voice Live is GA.
AZURE_OPENAI_API_VERSION="2025-04-01-preview"
AZURE_VOICELIVE_API_VERSION="2025-10-01"

# ── Foundry Agent (mode: agent only — leave blank if not used) ────────
# Provision a Foundry Agent in the same project, then paste its IDs here.
# The Agent rung auto-hides in the unified switcher if these are empty.
AGENT_PROJECT_NAME=""
AGENT_ID=""
